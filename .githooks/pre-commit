#!/usr/bin/env python
import os
import subprocess
import sys


def run(command):
    result = subprocess.run(command, shell=(os.name == "nt"))
    return result.returncode


def main():
    if run(["uv", "run", "task", "format"]) != 0:
        print("Format failed")
        sys.exit(1)

    if run(["uv", "run", "task", "lint"]) != 0:
        print("Lint failed")
        sys.exit(1)

    if run(["uv", "run", "task", "check"]) != 0:
        print("Type check failed")
        sys.exit(1)

    if run(["uv", "run", "task", "test"]) != 0:
        print("Tests failed")
        sys.exit(1)

    sys.exit(0)


if __name__ == "__main__":
    main()
